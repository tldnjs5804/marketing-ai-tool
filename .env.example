# 유튜브 댓글 수집 (YouTube Data API v3)
# https://console.cloud.google.com/apis/library/youtube.googleapis.com 에서 발급
YOUTUBE_API_KEY=

# 레딧 댓글 수집 (Reddit API, "script" 타입 앱)
# https://www.reddit.com/prefs/apps 에서 발급
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=marketing-ai-tool/1.0

# 네이버 뉴스 검색 (네이버 오픈API)
# https://developers.naver.com/apps 에서 발급
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
